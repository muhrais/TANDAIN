# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN commit file ".env" ke Git (sudah masuk .gitignore).

# Port server backend
PORT=3000

# Koneksi MongoDB lokal (mongod berjalan di laptop/PC sendiri)
# Pastikan MongoDB sudah terinstal & service "mongod" sedang berjalan.
MONGODB_URI=mongodb://127.0.0.1:27017/tandain

# Secret key untuk menandatangani JWT (ganti dengan string acak yang panjang)
JWT_SECRET=ganti_dengan_secret_key_yang_panjang_dan_acak
JWT_EXPIRES_IN=8h

# Environment: development | production
NODE_ENV=development
