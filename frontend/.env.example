# Base URL API backend.
#
# Kosongkan (biarkan setelah "=") untuk pakai path relatif — Vite dev server
# akan proxy semua request /api ke backend (lihat vite.config.js). Ini yang
# direkomendasikan: jalan baik di localhost maupun lewat tunnel (ngrok dkk)
# buat testing di HP, dan ga kena masalah CORS.
VITE_API_BASE_URL=

# Alternatif: hit backend langsung tanpa lewat proxy Vite (skip baris di atas).
# Cuma jalan kalau diakses dari localhost yang sama dengan backend-nya.
# VITE_API_BASE_URL=http://localhost:3000

# Interval polling dashboard dalam milidetik. Default 5000 (5 dtk, target PRD #3).
# VITE_POLL_INTERVAL_MS=5000

# Nama & lokasi insiden yang ditampilkan di Topbar dashboard. Belum ada
# endpoint backend untuk ini (GET /api/incident, stretch T-BE-7), jadi
# dikonfigurasi manual per sesi/demo lewat env.
# VITE_INCIDENT_NAME=Simulasi MCI Kampus UI
# VITE_INCIDENT_LOCATION=Kampus UI, Depok
